#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"

PORT=3847
PID_FILE=".test-serve.pid"

# Clean up any previous test server
if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
  kill "$(cat "$PID_FILE")" 2>/dev/null || true
  rm -f "$PID_FILE"
fi

# Build first
npm run build

# Start serve in background on test port
npm run serve -- -p "$PORT" &>/tmp/sparrow-test-serve.log &
echo $! > "$PID_FILE"

# Wait for server to be ready
for i in $(seq 1 10); do
  if curl -s -o /dev/null http://localhost:$PORT/ 2>/dev/null; then
    echo "Test server ready at http://localhost:$PORT (PID $(cat "$PID_FILE"))"
    exit 0
  fi
  sleep 0.5
done

echo "Warning: server may not be ready yet, check /tmp/sparrow-test-serve.log"
exit 1

#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"

PID_FILE=".test-serve.pid"

if [ ! -f "$PID_FILE" ]; then
  echo "No test server PID file found"
  exit 0
fi

PID=$(cat "$PID_FILE")
if kill -0 "$PID" 2>/dev/null; then
  kill "$PID"
  echo "Test server stopped (PID $PID)"
else
  echo "Test server process $PID already stopped"
fi

rm -f "$PID_FILE"
